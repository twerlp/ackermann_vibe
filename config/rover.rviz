Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1.0
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
    - Alpha: 1.0
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Reliability Policy: 1
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    - Alpha: 1.0
      Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15.0
      Frames:
        All Enabled: false
        base_footprint:
          Value: true
        base_link:
          Value: true
        lidar_link:
          Value: true
        imu_link:
          Value: true
        odom:
          Value: true
        fl_steering_knuckle:
          Value: false
        fr_steering_knuckle:
          Value: false
      Name: TF
      Show Arrows: true
      Show Names: true
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/LaserScan
      Color: 0; 255; 0
      Color Transformer: Intensity
      Decay Time: 3.0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 0.0
      Min Color: 0; 255; 0
      Min Intensity: 0.0
      Name: LaserScan
      Position Transformer: XYZ
      Selectable: true
      Size (m): 0.05
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Reliability Policy: 1
        Value: /scan
      Use Fixed Frame: true
    - Alpha: 1.0
      Buffer Length: 1.0
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry
      Topic:
        Depth: 5
        Reliability Policy: 1
        Value: /odom
      Value: true
    - Alpha: 0.7
      Buffer Length: 1.0
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Name: Trajectory
      Topic:
        Depth: 5
        Reliability Policy: 1
        Value: /rover/trajectory
      Value: true
    - Alpha: 1.0
      Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Gym Obstacles
      Topic:
        Depth: 5
        Reliability Policy: 1
        Value: /gym_obstacles
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
    - Class: rviz_default_plugins/PublishPoint
    - Class: rviz_default_plugins/PublishTwistStamped
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10.0
      Enable Stereo Rendering: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.5
      Focal Shape Fixed Size: true
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: base_link
      Yaw: 2.5
